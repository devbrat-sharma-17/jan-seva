# ============================================================
# Deployed build — committed, and therefore secret-free
# ============================================================
# Every value here ships in the browser bundle. Secrets belong in the
# Vercel project's environment variables, never in this file.

# ------------------------------------------------------------
# ⚠ THE GO-LIVE SWITCH IS THE NEXT LINE. ⚠
# ------------------------------------------------------------
# The deployed build is the STAKEHOLDER DEMO for now: seeded Gwalior
# data, Quick Demo sign-in, the fixed verification code. That is correct
# while there is no database, no authentication server and no SMS
# provider behind it — a "production" deployment today would be an empty
# shell nobody could sign into.
#
# Flip this to `production` when the backend lands. At that point the
# demo directory goes inert, Quick Demo disappears, 123456 stops
# verifying anyone, and the complaint store starts empty.
#
# `npm run selftest:prod` asserts what that flip does, independently of
# this file, so the lockout cannot rot while it is switched off.
VITE_APP_MODE=demo

VITE_PUBLIC_APP_URL=https://jan-seva.vercel.app
